# LiveKit (filled by `lk app env --write` after `lk cloud auth`)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TypeSafe
TYPESAFE_API_KEY=

# Local Postgres (docker compose)
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=voice_agent
POSTGRES_DB=voice_agent
POSTGRES_PORT=5434
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5434/voice_agent

# IGDB (Twitch Developer app — https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
