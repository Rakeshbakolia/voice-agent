# LiveKit (filled by `lk app env --write` after `lk cloud auth`)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TypeSafe
TYPESAFE_API_KEY=

# Local Postgres (docker compose)
POSTGRES_USER=voice_agent
POSTGRES_PASSWORD=voice_agent
POSTGRES_DB=voice_agent
POSTGRES_PORT=5434
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5434/voice_agent

# IGDB (Twitch Developer app — https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API (https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=

# GameBrain (https://gamebrain.co/api)
GAMEBRAIN_API_KEY=

# RAWG (https://rawg.io/apidocs)
RAWG_API_KEY=

# OpenAI — embeddings, semantic search, text chat streaming
OPENAI_API_KEY=
# Optional chat model (default gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Text chat API (catalog-chat-api); Next.js proxies /api/chat here
CHAT_API_URL=http://127.0.0.1:8765
CHAT_API_PORT=8765
