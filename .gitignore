# livekit.toml

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs & temp ---
*.log
logs/
tmp/
temp/

# --- Docker (local overrides only) ---
docker-compose.override.yml
