# --- Secrets & environment (never commit keys) ---
.env
.env.local
.env.*.local
**/.env
**/.env.local
# Allow committed templates
!.env.example
!.env.docker.example
!**/.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
**/.venv/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- uv / package managers ---
# Keep uv.lock tracked if you commit lockfiles; ignore local caches only
.uv/

# --- Ingest / local data caches ---
.cache/

# --- LiveKit / agent local config (if you add secrets here) ---
